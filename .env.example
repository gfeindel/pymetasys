# Serial-to-IP bridge
METASYS_BRIDGE_HOST=10.0.0.50
METASYS_BRIDGE_PORT=4001

# Panel Unit login password (System-capability account)
METASYS_PANEL_PASSWORD=changeme

# Web app
METASYS_SECRET_KEY=generate-a-long-random-string
METASYS_DATABASE_URL=sqlite+aiosqlite:///./metasys.db

# Bind
METASYS_HOST=0.0.0.0
METASYS_PORT=8000

# Timeouts (seconds)
METASYS_SETTLE_TIMEOUT=2.0
METASYS_SETTLE_QUIET_MS=150
METASYS_RECONNECT_MIN=1.0
METASYS_RECONNECT_MAX=30.0

# Alarm behavior
# Options for METASYS_ALARM_AUTOACK_BELOW: CRITICAL, NETWORK, FOLLOWUP, STATUS
METASYS_ALARM_AUTOACK_BELOW=CRITICAL

# Background group-summary poll interval (seconds)
METASYS_POLL_INTERVAL=10
